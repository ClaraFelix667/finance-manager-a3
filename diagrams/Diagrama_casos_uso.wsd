@startuml
left to right direction
skinparam actorStyle awesome

actor "Usuário" as a1
actor "Sistema Bancário (API)" as a2

package "Aplicativo de Gerenciamento de Finanças" {
    usecase "Cadastrar-se" as UC1
    usecase "Login" as UC2
    usecase "Preencher campos obrigatórios" as UC3
    usecase "Recuperar senha" as UC4
    usecase "Autenticação" as UC5
    usecase "Adicionar conta bancária" as UC6
    usecase "Cadastrar cartão de crédito" as UC7
    usecase "Registrar despesas e receitas" as UC8
    usecase "Editar transações" as UC9
    usecase "Excluir transação" as UC10
    usecase "Consultar transações" as UC11
    usecase "Definir metas mensais" as UC12
    usecase "Gerar relatórios gráficos" as UC13
    usecase "Receber alertas de vencimento" as UC14
    usecase "Integração com bancos via API" as UC15
    usecase "Consultoria financeira via IA" as UC16
    usecase "Obter mais informações" as UC17
}

' Conexões com Usuário
a1 - UC1
a1 - UC2
a1 - UC4
a1 - UC6
a1 - UC7
a1 - UC8
a1 - UC9
a1 - UC10
a1 - UC11
a1 - UC12
a1 - UC13
a1 - UC14
a1 - UC16

' Conexão com sistema bancário
a2 - UC15

' Relações entre casos de uso
UC1 ..> UC3 : <<include>>
UC2 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>
UC8 ..> UC9 : <<extend>>
UC8 ..> UC10 : <<extend>>
UC8 ..> UC11 : <<include>>
UC11 ..> UC13 : <<extend>>
UC12 ..> UC13 : <<extend>>
UC12 ..> UC14 : <<extend>>
UC15 ..> UC8 : <<include>>
UC16 ..> UC17 : <<extend>>

@enduml