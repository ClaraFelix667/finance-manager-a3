@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

actor Usuario [
    **Usuário**
]

actor Admin [
    **Admin**
]

package "Aplicativo de Finanças" {

    ' --- Enumerações (Tipos de dados) ---
    enum TipoTransacao {
        RECEITA
        DESPESA
    }

    enum TipoRelatorio {
        MENSAL
        ANUAL
    }

    ' --- Classes Principais ---
    class Usuario {
        - ID: int
        - Nome: string
        - Email: string
        - SenhaHash: string
        + AdicionarConta()
        + RegistrarTransacao()
        + CriarOrcamento()
        + GerarRelatorio()
    }

    class Conta {
        - ID: int
        - NomeInstituicao: string
        - Tipo: string ' Ex: Corrente, Poupança, Cartão
        - SaldoAtual: double
    }

    class Transacao {
        - ID: int
        - Valor: double
        - Categoria: string
        - Data: date
        - Recorrente: boolean
    }

    class Orcamento {
        - ID: int
        - Mes: date
        - Categoria: string
        - Limite: double
        - GastoAtual: double
        + VerificarAlertaLimite(): boolean
    }

    class Relatorio {
        - ID: int
        - Dados: JSON 
        + GerarGrafico()
    }

    class Integracao {
        - ID: int
        - API_Token: string
        - Banco: string
        - UltimaSincronizacao: timestamp
    }

    ' --- Novas Classes para a IA ---
    class Chat {
        - ID: int
        - Titulo: string
        - DataCriacao: datetime
        + AdicionarMensagem()
        + LimparHistorico()
    }

    class Mensagem {
        - ID: int
        - Conteudo: text
        - DataEnvio: datetime
    }

    ' Classe de Serviço (Lógica da IA)
    class "AssistenteFinanceiroIA" as IA <<Service>> {
        + GerarResumoMensal(mes, ano): string
        + ResponderUsuario(pergunta): string
        + AnalisarGastos(listaTransacoes): string
        + SugerirCategoria(descricao): string
    }
}

' --- Relacionamentos ---

' Herança
Admin --|> Usuario

' Composições (Dono -> Parte)
Usuario "1" *-- "N" Conta : "Possui"
Usuario "1" *-- "N" Transacao : "Registra"
Usuario "1" *-- "N" Orcamento : "Define"
Usuario "1" *-- "N" Chat : "Mantém"
Chat "1" *-- "N" Mensagem : "Contém"

' Associações
Usuario "1" -- "N" Relatorio : "Gera"
Usuario "1" -- "N" Integracao : "Gerencia"
Integracao "1" -- "1" Conta : "Sincroniza"

' Dependências (A IA precisa ler dados para funcionar)
IA ..> Transacao : "Lê e Analisa"
IA ..> Orcamento : "Verifica metas"
IA ..> Mensagem : "Gera resposta"

' Ligações com Enums
Transacao -- TipoTransacao
Relatorio -- TipoRelatorio
Mensagem -- Remetente

@enduml